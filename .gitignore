# --------------------------------------
# ⚙️ Runtime & Temp Data
# --------------------------------------
*/data/
*/work/
*/chunks/
*.pid
*.sock
*.db

# --------------------------------------
# 🔐 Secrets & Environment
# --------------------------------------
.env
secrets/
**/*secrets*/**

# --------------------------------------
# 🚫 Ignore full app data but keep config
# --------------------------------------
adguard/
homeassistant/
!homeassistant/configuration.yaml.example

# Data replaced by named volumes
portainer/
uptime-kuma/
grafana/
prometheus/

# Keep only config for these
!grafana/provisioning/
!grafana/dashboards/
!prometheus/prometheus.yml
!loki/config/
!loki/local-config.yaml
!promtail/config.yml

# Homepage config (only keep these)
homepage/
!homepage/bookmarks.yaml
!homepage/custom.css
!homepage/custom.js
!homepage/docker.yaml
!homepage/kubernetes.yaml
!homepage/services.yaml
!homepage/settings.yaml
!homepage/widgets.yaml

# --------------------------------------
# 🧹 Logs, Caches, Build Artifacts
# --------------------------------------
*.log
__pycache__/
*.pyc
node_modules/
.next/

# --------------------------------------
# 🖥 System Files
# --------------------------------------
.DS_Store
Thumbs.db
