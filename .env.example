TZ=Europe/London
EMAIL=you@example.com
APP_KEY=                            # base64: generate with: openssl rand -base64 32

# AdGuard IP (used as DNS for uptime-kuma)
ADGUARD_IP=192.168.x.x

# Homepage: restrict access to specific host(s), comma-separated
HOMEPAGE_ALLOWED_HOSTS=your.domain.com

# Watchtower notification URL (shoutrrr format)
# See: https://containrrr.dev/shoutrrr/v0.5/services/telegram/
WATCHTOWER_NOTIFICATION_URL=telegram://<token>@telegram?channels=<channel_id>

# GitHub Actions Runner token (from repo Settings > Actions > Runners)
GITHUB_RUNNER_TOKEN=
